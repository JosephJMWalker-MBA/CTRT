{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctrt.dev/schemas/extraction-method-registry.schema.json",
  "title": "CTRT Extraction Method Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_id", "registry_version", "status", "methods", "created_at"],
  "properties": {
    "registry_id": {"type": "string", "minLength": 1},
    "registry_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "accepted", "superseded"]},
    "methods": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/method"}
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method_id", "status", "license_review", "revision_policy",
        "supported_source_types", "permitted_mapping_kinds",
        "authorized_configuration_hashes"
      ],
      "properties": {
        "method_id": {"type": "string", "minLength": 1},
        "status": {
          "enum": [
            "proposed", "eligible_for_evaluation", "evaluated",
            "selected_for_domain", "deferred", "rejected_before_execution",
            "not_selected"
          ]
        },
        "license_review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": {
              "enum": ["pending", "provisionally_verified", "verified", "blocked"]
            }
          }
        },
        "revision_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pin_required", "pinned_revision"],
          "properties": {
            "pin_required": {"type": "boolean"},
            "pinned_revision": {"type": ["string", "null"], "minLength": 1}
          }
        },
        "supported_source_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["raw_text", "webpage", "transcript", "other"]}
        },
        "permitted_mapping_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"const": "exact"}
        },
        "authorized_configuration_hashes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  }
}
