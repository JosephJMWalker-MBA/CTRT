{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctrt.dev/schemas/dimension-eligibility.schema.json",
  "title": "CTRT Dimension Eligibility Record",
  "description": "A governance record determining whether a construct may appear in an experimental CTRT report.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "dimension_id",
    "dimension_version",
    "name",
    "status",
    "report_eligibility",
    "definition",
    "measurement_units",
    "claim_scope",
    "exclusions",
    "expected_output",
    "evidence_requirement",
    "known_confounds",
    "instrument_requirements",
    "normalization",
    "validation_requirements",
    "aggregation",
    "explanation_constraints",
    "open_questions",
    "decision_rationale",
    "decision_authority",
    "updated_at"
  ],
  "properties": {
    "record_type": {"const": "dimension_eligibility"},
    "dimension_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "dimension_version": {
      "type": "string",
      "pattern": "^0\\.[0-9]+\\.[0-9]+$"
    },
    "name": {"type": "string", "minLength": 1},
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "defined",
        "instrumented",
        "evaluated",
        "validated_for_domain",
        "deferred",
        "rejected"
      ]
    },
    "report_eligibility": {
      "type": "string",
      "enum": ["eligible_experimental", "ineligible", "pending"]
    },
    "definition": {"type": "string", "minLength": 1},
    "measurement_units": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["content_item", "segment"]}
    },
    "claim_scope": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "exclusions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "expected_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "required_keys", "notes"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["scalar", "distribution", "category_vector", "undetermined"]
        },
        "required_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "notes": {"type": "string"}
      }
    },
    "evidence_requirement": {
      "type": "string",
      "enum": ["item_level_only", "span_preferred", "span_required", "undetermined"]
    },
    "known_confounds": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "instrument_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permitted", "rule"],
      "properties": {
        "permitted": {"type": "boolean"},
        "rule": {"type": "string", "minLength": 1}
      }
    },
    "validation_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "aggregation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_appear_as_profile_component",
        "may_have_within_dimension_summary",
        "may_contribute_to_overall_rating",
        "constraints"
      ],
      "properties": {
        "may_appear_as_profile_component": {"type": "boolean"},
        "may_have_within_dimension_summary": {"type": "boolean"},
        "may_contribute_to_overall_rating": {"type": "boolean"},
        "constraints": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "explanation_constraints": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "open_questions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "decision_rationale": {"type": "string", "minLength": 1},
    "decision_authority": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
