{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://ctrt.dev/schemas/adjudicator-credential-attestation.schema.json","title":"Adjudicator credential attestation","type":"object","additionalProperties":false,"required":["artifact_id","attestation_id","credential_type","adjudicator_id","identity_revision","subject_reference","issuer_id","issuer_revision","authorized_roles","status","issued_at","valid_from","valid_until","revoked_at","revocation_reason"],"properties":{"artifact_id":{"type":"string","pattern":"^adjudicator-credential:.+"},"attestation_id":{"type":"string","minLength":1},"credential_type":{"type":"string","minLength":1},"adjudicator_id":{"type":"string","minLength":1},"identity_revision":{"type":"string","minLength":1},"subject_reference":{"type":"string","minLength":1},"issuer_id":{"type":"string","minLength":1},"issuer_revision":{"type":"string","minLength":1},"authorized_roles":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["witness_conflict_adjudicator"]}},"status":{"enum":["active","suspended","revoked"]},"issued_at":{"type":"string","format":"date-time"},"valid_from":{"type":"string","format":"date-time"},"valid_until":{"type":"string","format":"date-time"},"revoked_at":{"type":["string","null"],"format":"date-time"},"revocation_reason":{"type":["string","null"],"minLength":1}},"allOf":[{"if":{"properties":{"status":{"const":"revoked"}}},"then":{"properties":{"revoked_at":{"type":"string","format":"date-time"},"revocation_reason":{"type":"string","minLength":1}}},"else":{"properties":{"revoked_at":{"type":"null"},"revocation_reason":{"type":"null"}}}}]}
