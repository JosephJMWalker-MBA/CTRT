{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctrt.dev/schemas/governed-execution-receipt.schema.json",
  "title": "CTRT Verified Governed Execution Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "status",
    "experiment_id",
    "experiment_version",
    "run_id",
    "run_record_id",
    "content_id",
    "analyzer_ids",
    "result_statuses",
    "workbench_status",
    "bundle_id",
    "manifest_ref",
    "verified_checks",
    "started_at",
    "completed_at"
  ],
  "properties": {
    "session_id": {"type": "string", "minLength": 1},
    "status": {"const": "verified"},
    "experiment_id": {"type": "string", "minLength": 1},
    "experiment_version": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "run_record_id": {"type": "string", "minLength": 1},
    "content_id": {"type": "string", "minLength": 1},
    "analyzer_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "result_statuses": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "enum": ["success", "partial", "abstained", "failed"]
      }
    },
    "workbench_status": {
      "type": "string",
      "enum": ["complete", "partial", "abstained", "failed"]
    },
    "bundle_id": {"type": "string", "minLength": 1},
    "manifest_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_hash",
        "canonicalization_version",
        "media_type"
      ],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "canonicalization_version": {"const": "ctrt-canonical-json@0.1.0"},
        "media_type": {"const": "application/json"}
      }
    },
    "verified_checks": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {"const": "candidate-eligibility"},
        {"const": "runtime-revision"},
        {"const": "canonical-serialization"},
        {"const": "artifact-persistence"},
        {"const": "manifest-reverification"}
      ],
      "items": false
    },
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"}
  }
}
