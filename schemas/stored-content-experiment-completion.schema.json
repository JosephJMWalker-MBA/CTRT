{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctrt.dev/schemas/stored-content-experiment-completion.schema.json",
  "title": "CTRT Stored Content Experiment Completion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "completion_id",
    "experiment_run_id",
    "status",
    "experiment_id",
    "experiment_version",
    "corpus_manifest_ref",
    "corpus_bound_completion_ref",
    "content_ids",
    "content_artifact_refs",
    "verified_checks",
    "completed_at"
  ],
  "properties": {
    "completion_id": {"type": "string", "minLength": 1},
    "experiment_run_id": {"type": "string", "minLength": 1},
    "status": {"const": "verified"},
    "experiment_id": {"type": "string", "minLength": 1},
    "experiment_version": {"type": "string", "minLength": 1},
    "corpus_manifest_ref": {"$ref": "#/$defs/storedArtifactRef"},
    "corpus_bound_completion_ref": {"$ref": "#/$defs/storedArtifactRef"},
    "content_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "content_artifact_refs": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/storedArtifactRef"}
    },
    "verified_checks": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {"const": "canonical-content-artifacts-linked"},
        {"const": "stored-content-artifacts-reverified"},
        {"const": "execution-inputs-reconstructed"},
        {"const": "corpus-bound-completion-reverified"},
        {"const": "stored-content-completion-reverified"}
      ],
      "items": false
    },
    "completed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "storedArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_hash",
        "canonicalization_version",
        "media_type"
      ],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_hash": {"$ref": "#/$defs/sha256"},
        "canonicalization_version": {
          "const": "ctrt-canonical-json@0.1.0"
        },
        "media_type": {"const": "application/json"}
      }
    }
  }
}
