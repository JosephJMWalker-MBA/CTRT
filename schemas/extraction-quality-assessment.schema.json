{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctrt.dev/schemas/extraction-quality-assessment.schema.json",
  "title": "CTRT Extraction Quality Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "assessment_id",
    "content_id",
    "source_artifact_ref",
    "extraction_artifact_ref",
    "content_artifact_ref",
    "quality_policy_ref",
    "automated_checks",
    "reviewer_observations",
    "uncertainties",
    "quality_status",
    "issues",
    "abstention",
    "assessed_at"
  ],
  "properties": {
    "artifact_id": {"type": "string", "pattern": "^extraction-quality:.+"},
    "assessment_id": {"type": "string", "minLength": 1},
    "content_id": {"type": "string", "minLength": 1},
    "source_artifact_ref": {"$ref": "#/$defs/storedRef"},
    "extraction_artifact_ref": {"$ref": "#/$defs/storedRef"},
    "content_artifact_ref": {"$ref": "#/$defs/storedRef"},
    "quality_policy_ref": {"$ref": "#/$defs/versionedRef"},
    "automated_checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/check"}
    },
    "reviewer_observations": {
      "type": "array",
      "items": {"$ref": "#/$defs/reviewer"}
    },
    "uncertainties": {
      "type": "array",
      "items": {"$ref": "#/$defs/uncertainty"}
    },
    "quality_status": {"enum": ["clean", "partial", "degraded", "failed"]},
    "issues": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "abstention": {"$ref": "#/$defs/abstention"},
    "assessed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "storedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_hash",
        "canonicalization_version",
        "media_type"
      ],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_hash": {"$ref": "#/$defs/sha256"},
        "canonicalization_version": {"const": "ctrt-canonical-json@0.1.0"},
        "media_type": {"const": "application/json"}
      }
    },
    "versionedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_version", "artifact_hash"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_version": {"type": "string", "minLength": 1},
        "artifact_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "check_revision",
        "outcome",
        "details",
        "evidence_refs"
      ],
      "properties": {
        "check_id": {"type": "string", "minLength": 1},
        "check_revision": {"type": "string", "minLength": 1},
        "outcome": {"enum": ["passed", "failed", "not_applicable"]},
        "details": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "reviewer_role",
        "finding",
        "notes",
        "evidence_refs"
      ],
      "properties": {
        "observation_id": {"type": "string", "minLength": 1},
        "reviewer_role": {"type": "string", "minLength": 1},
        "finding": {"enum": ["confirmed", "issue", "uncertain"]},
        "notes": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uncertainty_id", "description", "evidence_refs"],
      "properties": {
        "uncertainty_id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "abstention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["triggered", "reasons"],
      "properties": {
        "triggered": {"type": "boolean"},
        "reasons": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
