{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctrt.dev/schemas/extraction-manifest.schema.json",
  "title": "CTRT Extraction Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "content_id",
    "source_artifact_ref",
    "method_id",
    "method_revision",
    "configuration_hash",
    "canonical_content_hash",
    "content_artifact_ref",
    "coordinate_map",
    "created_at"
  ],
  "properties": {
    "artifact_id": {"type": "string", "pattern": "^extraction:"},
    "content_id": {"type": "string", "minLength": 1},
    "source_artifact_ref": {"$ref": "#/$defs/storedArtifactRef"},
    "method_id": {"type": "string", "minLength": 1},
    "method_revision": {"type": "string", "minLength": 1},
    "configuration_hash": {"$ref": "#/$defs/sha256"},
    "canonical_content_hash": {"$ref": "#/$defs/sha256"},
    "content_artifact_ref": {"$ref": "#/$defs/storedArtifactRef"},
    "coordinate_map": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/coordinateSpan"}
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "storedArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_hash",
        "canonicalization_version",
        "media_type"
      ],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_hash": {"$ref": "#/$defs/sha256"},
        "canonicalization_version": {
          "const": "ctrt-canonical-json@0.1.0"
        },
        "media_type": {"const": "application/json"}
      }
    },
    "coordinateSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_start",
        "source_end",
        "canonical_start",
        "canonical_end",
        "kind"
      ],
      "properties": {
        "source_start": {"type": "integer", "minimum": 0},
        "source_end": {"type": "integer", "minimum": 1},
        "canonical_start": {"type": "integer", "minimum": 0},
        "canonical_end": {"type": "integer", "minimum": 1},
        "kind": {"const": "exact"}
      }
    }
  }
}
