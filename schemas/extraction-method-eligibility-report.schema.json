{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctrt.dev/schemas/extraction-method-eligibility-report.schema.json",
  "title": "CTRT Extraction Method Eligibility Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_id", "experiment_version", "corpus_ref",
    "method_registry_ref", "authorized_extractions"
  ],
  "properties": {
    "experiment_id": {"type": "string", "minLength": 1},
    "experiment_version": {"type": "string", "minLength": 1},
    "corpus_ref": {"$ref": "#/$defs/versionedRef"},
    "method_registry_ref": {"$ref": "#/$defs/versionedRef"},
    "authorized_extractions": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/authorizedExtraction"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "versionedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_version", "artifact_hash"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_version": {"type": "string", "minLength": 1},
        "artifact_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "authorizedExtraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_id", "extraction_artifact_id", "method_id",
        "method_revision", "configuration_hash", "source_type", "mapping_kinds"
      ],
      "properties": {
        "content_id": {"type": "string", "minLength": 1},
        "extraction_artifact_id": {"type": "string", "minLength": 1},
        "method_id": {"type": "string", "minLength": 1},
        "method_revision": {"type": "string", "minLength": 1},
        "configuration_hash": {"$ref": "#/$defs/sha256"},
        "source_type": {"enum": ["raw_text", "webpage", "transcript", "other"]},
        "mapping_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"const": "exact"}
        }
      }
    }
  }
}
