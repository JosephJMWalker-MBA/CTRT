{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctrt.local/schemas/checkpoint-gated-checkpoint-witness-conflict-revocation-final.schema.json",
  "title": "Checkpoint gated checkpoint witness conflict revocation final",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "final_id",
    "experiment_run_id",
    "status",
    "revocation_outcome",
    "credential_outcome",
    "checkpoint_witness_outcome",
    "resolution_status",
    "conflict_adjudication_outcome",
    "predecessor_witness_outcome",
    "inherited_revocation_outcome",
    "inherited_credential_outcome",
    "inherited_checkpoint_witness_outcome",
    "inherited_resolution_status",
    "inherited_adjudication_outcome",
    "terminal_outcome",
    "experiment_id",
    "experiment_version",
    "content_ids",
    "checkpoint_corpus_ref",
    "predecessor_revocation_corpus_ref",
    "checkpoint_policy_ref",
    "checkpoint_log_ref",
    "checkpoint_refs",
    "checkpoint_head_ref",
    "checkpoint_verification_ref",
    "revocation_final_ref",
    "verified_checks",
    "completed_at"
  ],
  "properties": {
    "final_id": {"type": "string", "minLength": 1},
    "experiment_run_id": {"type": "string", "minLength": 1},
    "status": {"const": "verified"},
    "revocation_outcome": {"enum": ["execute", "abstain"]},
    "credential_outcome": {
      "type": ["string", "null"],
      "enum": ["execute", "abstain", null]
    },
    "checkpoint_witness_outcome": {
      "type": ["string", "null"],
      "enum": ["execute", "abstain", null]
    },
    "resolution_status": {
      "type": ["string", "null"],
      "enum": ["not_required", "pending", "unresolved", "resolved", null]
    },
    "conflict_adjudication_outcome": {
      "type": ["string", "null"],
      "enum": ["execute", "abstain", null]
    },
    "predecessor_witness_outcome": {
      "type": ["string", "null"],
      "enum": ["execute", "abstain", null]
    },
    "inherited_revocation_outcome": {
      "type": ["string", "null"],
      "enum": ["execute", "abstain", null]
    },
    "inherited_credential_outcome": {
      "type": ["string", "null"],
      "enum": ["execute", "abstain", null]
    },
    "inherited_checkpoint_witness_outcome": {
      "type": ["string", "null"],
      "enum": ["execute", "abstain", null]
    },
    "inherited_resolution_status": {
      "type": ["string", "null"],
      "enum": ["not_required", "pending", "unresolved", "resolved", null]
    },
    "inherited_adjudication_outcome": {
      "type": ["string", "null"],
      "enum": ["execute", "abstain", null]
    },
    "terminal_outcome": {"enum": ["execute", "abstain"]},
    "experiment_id": {"type": "string", "minLength": 1},
    "experiment_version": {"type": "string", "minLength": 1},
    "content_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "checkpoint_corpus_ref": {"$ref": "#/$defs/storedRef"},
    "predecessor_revocation_corpus_ref": {"$ref": "#/$defs/versionedRef"},
    "checkpoint_policy_ref": {"$ref": "#/$defs/storedRef"},
    "checkpoint_log_ref": {"$ref": "#/$defs/storedRef"},
    "checkpoint_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/storedRef"}
    },
    "checkpoint_head_ref": {"$ref": "#/$defs/storedRef"},
    "checkpoint_verification_ref": {"$ref": "#/$defs/storedRef"},
    "revocation_final_ref": {"$ref": "#/$defs/storedRef"},
    "verified_checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "completed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "storedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_hash",
        "canonicalization_version",
        "media_type"
      ],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "canonicalization_version": {
          "const": "ctrt-canonical-json@0.1.0"
        },
        "media_type": {"const": "application/json"}
      }
    },
    "versionedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_version", "artifact_hash"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_version": {"type": "string", "minLength": 1},
        "artifact_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
