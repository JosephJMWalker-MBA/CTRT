{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctrt.dev/schemas/corpus-manifest.schema.json",
  "title": "CTRT Frozen Corpus Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "corpus_id",
    "corpus_version",
    "status",
    "created_at",
    "contents"
  ],
  "properties": {
    "corpus_id": {"type": "string", "minLength": 1},
    "corpus_version": {"type": "string", "minLength": 1},
    "status": {"const": "frozen"},
    "created_at": {"type": "string", "format": "date-time"},
    "contents": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/contentEntry"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "storedArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_hash",
        "canonicalization_version",
        "media_type"
      ],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_hash": {"$ref": "#/$defs/sha256"},
        "canonicalization_version": {
          "const": "ctrt-canonical-json@0.1.0"
        },
        "media_type": {"const": "application/json"}
      }
    },
    "contentEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "content_id",
        "content_hash",
        "language",
        "source_type",
        "extraction_ref"
      ],
      "properties": {
        "position": {"type": "integer", "minimum": 0},
        "content_id": {"type": "string", "minLength": 1},
        "content_hash": {"$ref": "#/$defs/sha256"},
        "language": {"type": "string", "minLength": 1},
        "source_type": {
          "enum": ["raw_text", "webpage", "transcript", "other"]
        },
        "source_uri": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "extraction_ref": {"type": "string", "minLength": 1},
        "content_artifact_ref": {"$ref": "#/$defs/storedArtifactRef"}
      }
    }
  }
}
