{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://ctrt.dev/schemas/adjudicator-credential-policy.schema.json","title":"Adjudicator credential policy","type":"object","additionalProperties":false,"required":["policy_id","policy_version","status","issuer_registry_ref","adjudicator_registry_ref","credential_type","require_exact_role_match","abstain_on_not_yet_valid","abstain_on_expired","abstain_on_suspended","abstain_on_revoked","created_at"],"properties":{"policy_id":{"type":"string","minLength":1},"policy_version":{"type":"string","minLength":1},"status":{"enum":["draft","accepted","superseded"]},"issuer_registry_ref":{"$ref":"#/$defs/versionedRef"},"adjudicator_registry_ref":{"$ref":"#/$defs/versionedRef"},"credential_type":{"type":"string","minLength":1},"require_exact_role_match":{"const":true},"abstain_on_not_yet_valid":{"const":true},"abstain_on_expired":{"const":true},"abstain_on_suspended":{"const":true},"abstain_on_revoked":{"const":true},"created_at":{"type":"string","format":"date-time"}},"$defs":{"versionedRef":{"type":"object","additionalProperties":false,"required":["artifact_id","artifact_version","artifact_hash"],"properties":{"artifact_id":{"type":"string","minLength":1},"artifact_version":{"type":"string","minLength":1},"artifact_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}}}}
