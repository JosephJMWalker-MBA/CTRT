{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctrt.dev/schemas/extraction-quality-policy.schema.json",
  "title": "CTRT Extraction Quality Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_id",
    "policy_version",
    "status",
    "required_checks",
    "minimum_reviewer_observations",
    "abstain_on_statuses",
    "created_at"
  ],
  "properties": {
    "policy_id": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "accepted", "superseded"]},
    "required_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "check_revision"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "check_revision": {"type": "string", "minLength": 1}
        }
      }
    },
    "minimum_reviewer_observations": {"type": "integer", "minimum": 0},
    "abstain_on_statuses": {
      "type": "array",
      "minItems": 1,
      "contains": {"const": "failed"},
      "items": {"enum": ["clean", "partial", "degraded", "failed"]},
      "uniqueItems": true
    },
    "created_at": {"type": "string", "format": "date-time"}
  }
}
