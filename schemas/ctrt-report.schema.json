{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctrt.dev/schemas/ctrt-report.schema.json",
  "title": "CTRT Analysis Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "specification_version",
    "content_id",
    "status",
    "model_results",
    "dimension_summaries",
    "confidence",
    "aggregation_policy",
    "disagreement",
    "explanations",
    "confidence_explanation",
    "limitations",
    "created_at"
  ],
  "properties": {
    "report_id": {"type": "string", "minLength": 1},
    "specification_version": {"type": "string", "minLength": 1},
    "content_id": {"type": "string", "minLength": 1},
    "status": {
      "type": "string",
      "enum": ["complete", "partial", "abstained", "failed"]
    },
    "model_results": {
      "type": "array",
      "items": {"$ref": "model-result.schema.json"}
    },
    "dimension_summaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimension_id",
          "dimension_version",
          "status",
          "included_result_ids",
          "excluded_results",
          "scores",
          "agreement"
        ],
        "properties": {
          "dimension_id": {"type": "string", "minLength": 1},
          "dimension_version": {"type": "string", "minLength": 1},
          "status": {
            "type": "string",
            "enum": ["available", "partial", "abstained", "unavailable"]
          },
          "included_result_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "excluded_results": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["result_id", "reason"],
              "properties": {
                "result_id": {"type": "string", "minLength": 1},
                "reason": {"type": "string", "minLength": 1}
              }
            }
          },
          "scores": {"type": "object"},
          "agreement": {
            "$ref": "confidence-vector.schema.json#/$defs/interInstrumentAgreement"
          }
        }
      }
    },
    "confidence": {"$ref": "confidence-vector.schema.json"},
    "aggregation_policy": {"$ref": "aggregation-policy.schema.json"},
    "disagreement": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension_id", "result_ids", "description", "material"],
        "properties": {
          "dimension_id": {"type": "string", "minLength": 1},
          "result_ids": {
            "type": "array",
            "minItems": 2,
            "items": {"type": "string", "minLength": 1}
          },
          "description": {"type": "string", "minLength": 1},
          "material": {"type": "boolean"}
        }
      }
    },
    "aggregate": {
      "type": ["object", "null"],
      "description": "Optional content aggregate. It may not contain a scalar confidence field."
    },
    "explanations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "method_version", "text", "supported_by_result_ids"],
        "properties": {
          "method": {"type": "string", "minLength": 1},
          "method_version": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "supported_by_result_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "evidence_span_indices": {
            "type": "array",
            "items": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "confidence_explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "method_version",
        "text",
        "source_signals",
        "scalar_confidence_generated"
      ],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "method_version": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "source_signals": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "aggregation-policy.schema.json#/$defs/confidenceSignal"}
        },
        "scalar_confidence_generated": {"const": false}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "abstained"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "confidence": {
            "properties": {
              "system_abstention": {
                "properties": {"triggered": {"const": true}}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "confidence": {
            "properties": {
              "system_abstention": {
                "properties": {"triggered": {"const": true}},
                "required": ["triggered"]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "status": {"enum": ["abstained", "failed"]}
        }
      }
    }
  ]
}
