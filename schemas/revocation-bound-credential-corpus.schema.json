{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://ctrt.dev/schemas/revocation-bound-credential-corpus.schema.json","title":"Revocation-bound credential corpus","type":"object","additionalProperties":false,"required":["corpus_id","corpus_version","status","method_registry_ref","quality_policy_ref","reviewer_registry_ref","review_adjudication_policy_ref","contents","created_at","predecessor_corpus_ref","credential_issuer_registry_ref","reviewer_credential_policy_ref","reviewer_credentials","revocation_predecessor_corpus_ref","credential_revocation_policy_ref","credential_revocation_ledger_ref"],"properties":{"corpus_id":{"type":"string","minLength":1},"corpus_version":{"type":"string","minLength":1},"status":{"const":"frozen"},"method_registry_ref":{"$ref":"#/$defs/versionedRef"},"quality_policy_ref":{"$ref":"#/$defs/versionedRef"},"reviewer_registry_ref":{"$ref":"#/$defs/versionedRef"},"review_adjudication_policy_ref":{"$ref":"#/$defs/versionedRef"},"contents":{"type":"array","minItems":2,"items":{"type":"object"}},"created_at":{"type":"string","format":"date-time"},"predecessor_corpus_ref":{"$ref":"#/$defs/versionedRef"},"credential_issuer_registry_ref":{"$ref":"#/$defs/versionedRef"},"reviewer_credential_policy_ref":{"$ref":"#/$defs/versionedRef"},"reviewer_credentials":{"type":"array","minItems":1,"items":{"type":"object"}},"revocation_predecessor_corpus_ref":{"$ref":"#/$defs/versionedRef"},"credential_revocation_policy_ref":{"$ref":"#/$defs/versionedRef"},"credential_revocation_ledger_ref":{"$ref":"#/$defs/versionedRef"}},"$defs":{"versionedRef":{"type":"object","additionalProperties":false,"required":["artifact_id","artifact_version","artifact_hash"],"properties":{"artifact_id":{"type":"string","minLength":1},"artifact_version":{"type":"string","minLength":1},"artifact_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}}}}
