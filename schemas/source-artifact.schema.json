{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctrt.dev/schemas/source-artifact.schema.json",
  "title": "CTRT Source Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "source_id",
    "text",
    "source_hash",
    "source_type",
    "source_uri"
  ],
  "properties": {
    "artifact_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "text": {"type": "string", "minLength": 1},
    "source_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_type": {
      "enum": ["raw_text", "webpage", "transcript", "other"]
    },
    "source_uri": {
      "type": ["string", "null"],
      "minLength": 1
    }
  }
}
