{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctrt.dev/schemas/content-item.schema.json",
  "title": "CTRT Content Item",
  "type": "object",
  "additionalProperties": false,
  "required": ["content_id", "text", "source_type", "content_hash"],
  "properties": {
    "content_id": {"type": "string", "minLength": 1},
    "text": {"type": "string", "minLength": 1},
    "source_type": {
      "type": "string",
      "enum": ["raw_text", "webpage", "transcript", "other"]
    },
    "content_hash": {"type": "string", "minLength": 1},
    "source_uri": {"type": ["string", "null"], "format": "uri"},
    "language": {"type": ["string", "null"], "minLength": 2},
    "extraction": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "extractor_id": {"type": "string", "minLength": 1},
        "extractor_version": {"type": "string", "minLength": 1},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
