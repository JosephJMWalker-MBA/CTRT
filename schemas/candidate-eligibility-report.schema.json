{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctrt.dev/schemas/candidate-eligibility-report.schema.json",
  "title": "CTRT Candidate Eligibility Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_id",
    "experiment_version",
    "candidate_registry_ref",
    "authorized_candidate_ids",
    "authorized_analyzer_ids"
  ],
  "properties": {
    "experiment_id": {"type": "string", "minLength": 1},
    "experiment_version": {"type": "string", "minLength": 1},
    "candidate_registry_ref": {
      "$ref": "experiment-plan.schema.json#/$defs/versionedArtifactRef"
    },
    "authorized_candidate_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "authorized_analyzer_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
