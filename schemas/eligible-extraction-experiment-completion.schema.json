{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctrt.dev/schemas/eligible-extraction-experiment-completion.schema.json",
  "title": "CTRT Eligible Extraction Experiment Completion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "completion_id", "experiment_run_id", "status", "experiment_id",
    "experiment_version", "content_ids", "method_registry_ref",
    "eligibility_report_ref", "extraction_bound_completion_ref",
    "authorized_extractions", "verified_checks", "completed_at"
  ],
  "properties": {
    "completion_id": {"type": "string", "minLength": 1},
    "experiment_run_id": {"type": "string", "minLength": 1},
    "status": {"const": "verified"},
    "experiment_id": {"type": "string", "minLength": 1},
    "experiment_version": {"type": "string", "minLength": 1},
    "content_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "method_registry_ref": {"$ref": "#/$defs/storedRef"},
    "eligibility_report_ref": {"$ref": "#/$defs/storedRef"},
    "extraction_bound_completion_ref": {"$ref": "#/$defs/storedRef"},
    "authorized_extractions": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/authorizedExtraction"}
    },
    "verified_checks": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        {"const": "exact-method-registry-bound"},
        {"const": "method-registry-accepted"},
        {"const": "method-revisions-authorized"},
        {"const": "source-types-and-mapping-kinds-authorized"},
        {"const": "configuration-hashes-authorized"},
        {"const": "eligibility-report-persisted"},
        {"const": "extraction-bound-completion-reverified"},
        {"const": "eligible-extraction-completion-reverified"}
      ],
      "items": false
    },
    "completed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "storedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_hash", "canonicalization_version", "media_type"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_hash": {"$ref": "#/$defs/sha256"},
        "canonicalization_version": {"const": "ctrt-canonical-json@0.1.0"},
        "media_type": {"const": "application/json"}
      }
    },
    "authorizedExtraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_id", "extraction_artifact_id", "method_id",
        "method_revision", "configuration_hash", "source_type", "mapping_kinds"
      ],
      "properties": {
        "content_id": {"type": "string", "minLength": 1},
        "extraction_artifact_id": {"type": "string", "minLength": 1},
        "method_id": {"type": "string", "minLength": 1},
        "method_revision": {"type": "string", "minLength": 1},
        "configuration_hash": {"$ref": "#/$defs/sha256"},
        "source_type": {"enum": ["raw_text", "webpage", "transcript", "other"]},
        "mapping_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"const": "exact"}
        }
      }
    }
  }
}
