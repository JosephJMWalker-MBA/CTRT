{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://ctrt.dev/schemas/checkpoint-witness-policy.schema.json","title":"Checkpoint Witness Policy","type":"object","additionalProperties":false,"required":["policy_id","policy_version","status","witness_registry_ref","required_witness_ids","abstain_on_conflicting_head","forbid_vote_aggregation","created_at"],"properties":{"policy_id":{"type":"string","minLength":1},"policy_version":{"type":"string","minLength":1},"status":{"enum":["draft","accepted","superseded"]},"witness_registry_ref":{"type":"object","additionalProperties":false,"required":["artifact_id","artifact_version","artifact_hash"],"properties":{"artifact_id":{"type":"string","minLength":1},"artifact_version":{"type":"string","minLength":1},"artifact_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}},"required_witness_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"abstain_on_conflicting_head":{"const":true},"forbid_vote_aggregation":{"const":true},"created_at":{"type":"string","format":"date-time"}}}